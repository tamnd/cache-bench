# What gets built, and at which commit.
#
# Every one of these is written into every run file this harness produces, so these lines are part of the results rather than part of the setup. A sweep on one host and a sweep on another are only comparable if these match, which is why they are pinned here instead of being whatever each box happened to have on the day.
#
# Bumping one is a commit of its own, so that a chart that moved can be traced to the thing that moved it.

MEMTIER_REF=2.5.1
MEMCACHED_REF=1.6.45
REDIS_REF=8.10.1
VALKEY_REF=9.1.2
DRAGONFLY_REF=v1.40.2
GARNET_REF=v2.1.5
POGOCACHE_REF=1.3.2
# v0.3.20 rather than anything earlier because `yodb serve --threads` arrives in it, and every other engine here is given a thread count. A yo pinned below it is started with a flag it rejects and exits before it listens, which is what happened on the first real measurement.
YO_REF=v0.3.20
RUGO_REF=main

# rugo is the one line here that is not a tag, and that is deliberate rather than an oversight.
#
# It has not had a release yet, and the point of it is to be rebuilt between sweeps while it is being optimised, so pinning it to a tag would mean a tag per iteration. Every rugo build reports the same version until 0.1.0 is cut, so a run file cannot tell two of them apart; a sweep whose rugo numbers are meant to be compared with another sweep's has to record the commit somewhere the run file is not, which for now is the sweep note.
#
# This becomes a tag at 0.1.0, and the moment it does the paragraph above goes away.

# Garnet is .NET and pins its own SDK in a global.json. This is that major version, which is what the installer is asked for.
DOTNET_CHANNEL=10.0

# Where the Garnet build leaves its binary. It follows the target framework, so this moves when the SDK does, and config.jsonc has to agree with it.
GARNET_FRAMEWORK=net10.0
