# Everything is LF in the repository and LF in the working tree, on every platform.
# The default on Windows is to convert on checkout, and that would be fine for source but not for anything here that is compared byte for byte.
* text=auto eol=lf

# Golden data is never touched. These are real result files from the original harness and the round trip test asserts that reading and writing one gives back the same bytes, so a line ending rewrite on checkout turns into a test failure on Windows and nowhere else.
testdata/golden/** -text

# Generated charts and fonts.
*.png binary
*.ttf binary
*.otf binary
